rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'shoplikevintage@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if true;
      allow get: if isAdmin() || (resource.data.order_ref == orderId);
      allow list, update, delete: if isAdmin();
    }
    match /user_profiles/{userId} {
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list, update, delete: if isAdmin();
    }
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}